{
  "name": "twitch-trigger-overlay-animations",
  "description": "Standalone HTML overlay animations triggered by Twitch chat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "format": "prettier --write \"src/**/*.html\" \"dist/**/*.html\" \"dist/**/*.css\" \"scripts/**/*.mjs\" \"*.md\" \".codex/**/*.md\" \".agents/**/*.md\" \".agents/**/*.yaml\"",
    "format:check": "prettier --check \"src/**/*.html\" \"dist/**/*.html\" \"dist/**/*.css\" \"scripts/**/*.mjs\" \"*.md\" \".codex/**/*.md\" \".agents/**/*.md\" \".agents/**/*.yaml\"",
    "check:contract": "node scripts/validate-animation.mjs",
    "check": "npm run format:check && npm run check:contract"
  },
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.5"
  }
}
